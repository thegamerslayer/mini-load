# Load Balancer Configuration
LB_PORT=8080
LB_STRATEGY=round_robin
HEALTH_CHECK_INTERVAL=5.0
HEALTH_CHECK_TIMEOUT=2.0
HEALTH_CHECK_UNHEALTHY_THRESHOLD=3
HEALTH_CHECK_HEALTHY_THRESHOLD=2

# Backend Configuration (Defaults for local dev)
BACKENDS=http://localhost:8001,http://localhost:8002,http://localhost:8003

# Single Backend Configuration (used when running backends individually)
SERVER_NAME=server2
SERVER_PORT=8002
SERVER_WORK_DELAY_MS=0
